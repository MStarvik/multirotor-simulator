include_guard(GLOBAL)

# Compiles GLSL shaders to SPIR-V and embeds them in the program.
# Requires find_package(Vulkan COMPONENTS glslc) to have been called.

# add_shader_library(<target> <shader>...)
#
# Compiles each GLSL shader with glslc and embeds the resulting SPIR-V in the
# static library <target> using C23 #embed. A shader named "<name>.<stage>"
# (e.g. "triangle.vert") becomes the symbols
#
#   const unsigned char <target>_<name>_<stage>[];  // 4-byte aligned SPIR-V
#   const size_t <target>_<name>_<stage>_size;      // in bytes
#
# declared in the generated header "<target>.h". Debug builds keep debug info in
# the SPIR-V for tools like RenderDoc; other builds are optimized.
function(add_shader_library target)
  set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}")
  file(MAKE_DIRECTORY "${out_dir}")

  set(spirv_files "")
  set(declarations "")
  set(definitions "")

  foreach(shader IN LISTS ARGN)
    cmake_path(ABSOLUTE_PATH shader BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
      OUTPUT_VARIABLE source)
    cmake_path(GET source FILENAME file_name)
    string(MAKE_C_IDENTIFIER "${target}_${file_name}" symbol)
    set(spirv "${out_dir}/${file_name}.spv")

    add_custom_command(
      OUTPUT "${spirv}"
      COMMAND Vulkan::glslc
        --target-env=vulkan1.4
        "$<IF:$<CONFIG:Debug>,-g,-O>"
        -MD -MF "${spirv}.d"
        -o "${spirv}" "${source}"
      DEPENDS "${source}"
      DEPFILE "${spirv}.d"
      COMMENT "Compiling shader ${file_name}"
      VERBATIM)

    list(APPEND spirv_files "${spirv}")
    string(APPEND declarations
      "extern const unsigned char ${symbol}[];\n"
      "extern const size_t ${symbol}_size;\n")
    string(APPEND definitions
      "alignas(4) const unsigned char ${symbol}[] = {\n"
      "#embed \"${spirv}\"\n"
      "};\n"
      "const size_t ${symbol}_size = sizeof ${symbol};\n\n")
  endforeach()

  # file(CONFIGURE) only rewrites the files when their content changes.
  set(header "${out_dir}/${target}.h")
  file(CONFIGURE OUTPUT "${header}" @ONLY CONTENT [[
// Generated by add_shader_library(); do not edit.
#pragma once

#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

@declarations@
#ifdef __cplusplus
}
#endif
]])
  set(embed_source "${out_dir}/${target}.c")
  file(CONFIGURE OUTPUT "${embed_source}" @ONLY CONTENT [[
// Generated by add_shader_library(); do not edit.
#include "@target@.h"

@definitions@]])

  add_library(${target} STATIC "${embed_source}" "${header}" ${spirv_files})
  target_include_directories(${target} PUBLIC "${out_dir}")
  set_target_properties(${target} PROPERTIES
    C_STANDARD 23
    C_STANDARD_REQUIRED ON)
  # Compile the embedding source only after the SPIR-V exists, and again when it changes.
  set_source_files_properties("${embed_source}" PROPERTIES OBJECT_DEPENDS "${spirv_files}")
endfunction()
